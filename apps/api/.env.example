# PostgreSQL connection string. Replace each placeholder in your local .env.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE_NAME?schema=public"

# Runtime mode. Use production on hosted environments.
NODE_ENV="development"

# One or more comma-separated browser origins allowed by CORS. Use exact origins,
# without a trailing path, for example https://your-app.vercel.app. Production
# requires https.
FRONTEND_URL="http://localhost:3000"

# Port used by the NestJS HTTP server.
PORT=3001

# JWT settings for backend-only, cookie-based staff authentication.
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="8h"

# Required only when intentionally running `npm run db:seed`. This password is
# assigned to the seeded reviewer staff accounts; never commit its real value.
SEED_STAFF_PASSWORD="replace-with-a-seed-only-password"
