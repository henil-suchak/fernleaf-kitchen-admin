generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id              String           @id @default(uuid()) @db.Uuid
  code            String           @unique
  name            String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  staffUsers      StaffUser[]
  rolePermissions RolePermission[]
}

model StaffUser {
  id                     String             @id @default(uuid()) @db.Uuid
  email                  String             @unique
  passwordHash           String
  isActive               Boolean            @default(true)
  roleId                 String             @db.Uuid
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  role                   Role               @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  defaultDriverCompanies Company[]          @relation("CompanyDefaultDriver")
  orderStatusEvents      OrderStatusEvent[] @relation("OrderStatusEventActor")
  assignedDispatchDrops  DispatchDrop[]     @relation("DispatchDropDriver")
}

model Permission {
  id              String           @id @default(uuid()) @db.Uuid
  code            String           @unique
  description     String
  rolePermissions RolePermission[]
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([roleId, permissionId])
}

enum KitchenSettingsKey {
  GLOBAL
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model KitchenSettings {
  key               KitchenSettingsKey @id @default(GLOBAL)
  timezone          String             @db.VarChar(64)
  workingDays       Weekday[]
  cutoffWorkingDays Int
  cutoffTimeMinutes Int
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model KitchenHoliday {
  id        String   @id @default(uuid()) @db.Uuid
  date      DateTime @unique @db.Date
  name      String?  @db.VarChar(120)
  createdAt DateTime @default(now())
}

model Allergen {
  id                String             @id @default(uuid()) @db.Uuid
  name              String             @db.VarChar(80)
  normalizedName    String             @unique @db.VarChar(80)
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  dishAllergens     DishAllergen[]
  optionAllergens   OptionAllergen[]
  employeeAllergens EmployeeAllergen[]
}

model DietaryTag {
  id                  String               @id @default(uuid()) @db.Uuid
  name                String               @db.VarChar(80)
  normalizedName      String               @unique @db.VarChar(80)
  isActive            Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  dishDietaryTags     DishDietaryTag[]
  optionDietaryTags   OptionDietaryTag[]
  employeeDietaryTags EmployeeDietaryTag[]
}

model KitchenStation {
  id             String      @id @default(uuid()) @db.Uuid
  name           String      @db.VarChar(80)
  normalizedName String      @unique @db.VarChar(80)
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  dishes         Dish[]
  orderLines     OrderLine[] @relation("KitchenStationOrderLines")
}

enum DishTemperature {
  HOT
  COLD
  AMBIENT
}

model Dish {
  id                String             @id @default(uuid()) @db.Uuid
  name              String             @db.VarChar(120)
  description       String?            @db.VarChar(1000)
  imageUrl          String?            @db.VarChar(2048)
  sku               String             @unique @db.VarChar(64)
  temperature       DishTemperature
  costMinorUnits    Int
  minimumQuantity   Int
  isActive          Boolean            @default(true)
  kitchenStationId  String?            @db.Uuid
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  kitchenStation    KitchenStation?    @relation(fields: [kitchenStationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  dishAllergens     DishAllergen[]
  dishDietaryTags   DishDietaryTag[]
  dishOptionGroups  DishOptionGroup[]
  dishPrices        DishTierPrice[]
  menuCategoryItems MenuCategoryItem[]
  orderLines        OrderLine[]        @relation("DishOrderLines")
}

model Option {
  id                      String                   @id @default(uuid()) @db.Uuid
  name                    String                   @db.VarChar(80)
  normalizedName          String                   @unique @db.VarChar(80)
  costMinorUnits          Int                      @default(0)
  isActive                Boolean                  @default(true)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  optionGroupOptions      OptionGroupOption[]
  optionAllergens         OptionAllergen[]
  optionDietaryTags       OptionDietaryTag[]
  optionPrices            OptionTierPrice[]
  orderCombinationOptions OrderCombinationOption[] @relation("OrderCombinationOptions")
}

model OptionGroup {
  id                      String                   @id @default(uuid()) @db.Uuid
  name                    String                   @db.VarChar(80)
  normalizedName          String                   @unique @db.VarChar(80)
  isActive                Boolean                  @default(true)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  dishOptionGroups        DishOptionGroup[]
  optionGroupOptions      OptionGroupOption[]
  orderCombinationOptions OrderCombinationOption[] @relation("OrderCombinationOptionGroups")
}

model DishOptionGroup {
  dishId        String      @db.Uuid
  optionGroupId String      @db.Uuid
  isRequired    Boolean
  sortOrder     Int
  dish          Dish        @relation(fields: [dishId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  optionGroup   OptionGroup @relation(fields: [optionGroupId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([dishId, optionGroupId])
  @@unique([dishId, sortOrder])
}

model OptionGroupOption {
  optionGroupId String      @db.Uuid
  optionId      String      @db.Uuid
  sortOrder     Int
  optionGroup   OptionGroup @relation(fields: [optionGroupId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  option        Option      @relation(fields: [optionId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([optionGroupId, optionId])
  @@unique([optionGroupId, sortOrder])
}

model DishAllergen {
  dishId     String   @db.Uuid
  allergenId String   @db.Uuid
  dish       Dish     @relation(fields: [dishId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  allergen   Allergen @relation(fields: [allergenId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([dishId, allergenId])
}

model DishDietaryTag {
  dishId       String     @db.Uuid
  dietaryTagId String     @db.Uuid
  dish         Dish       @relation(fields: [dishId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  dietaryTag   DietaryTag @relation(fields: [dietaryTagId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([dishId, dietaryTagId])
}

model OptionAllergen {
  optionId   String   @db.Uuid
  allergenId String   @db.Uuid
  option     Option   @relation(fields: [optionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  allergen   Allergen @relation(fields: [allergenId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([optionId, allergenId])
}

model OptionDietaryTag {
  optionId     String     @db.Uuid
  dietaryTagId String     @db.Uuid
  option       Option     @relation(fields: [optionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  dietaryTag   DietaryTag @relation(fields: [dietaryTagId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([optionId, dietaryTagId])
}

enum PricingDerivationSource {
  BASE_TIER
  ITEM_COST
}

model PricingTier {
  id               String                   @id @default(uuid()) @db.Uuid
  name             String                   @db.VarChar(80)
  normalizedName   String                   @unique @db.VarChar(80)
  isDefault        Boolean                  @default(false)
  isActive         Boolean                  @default(true)
  derivationSource PricingDerivationSource?
  baseTierId       String?                  @db.Uuid
  multiplierBps    Int?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  baseTier         PricingTier?             @relation("PricingTierBase", fields: [baseTierId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  derivedTiers     PricingTier[]            @relation("PricingTierBase")
  dishPrices       DishTierPrice[]
  optionPrices     OptionTierPrice[]
  companies        Company[]                @relation("CompanyPricingTier")
  orders           Order[]                  @relation("OrderEffectivePricingTier")
}

model DishTierPrice {
  pricingTierId           String      @db.Uuid
  dishId                  String      @db.Uuid
  explicitPriceMinorUnits Int
  pricingTier             PricingTier @relation(fields: [pricingTierId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  dish                    Dish        @relation(fields: [dishId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([pricingTierId, dishId])
}

model OptionTierPrice {
  pricingTierId           String      @db.Uuid
  optionId                String      @db.Uuid
  explicitPriceMinorUnits Int
  pricingTier             PricingTier @relation(fields: [pricingTierId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  option                  Option      @relation(fields: [optionId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([pricingTierId, optionId])
}

model Company {
  id                         String                      @id @default(uuid()) @db.Uuid
  name                       String                      @db.VarChar(160)
  normalizedName             String                      @db.VarChar(160)
  billingContactName         String                      @db.VarChar(120)
  billingContactEmail        String                      @db.VarChar(320)
  billingContactPhone        String?                     @db.VarChar(32)
  workingDays                Weekday[]                   @default([MONDAY, TUESDAY, WEDNESDAY, THURSDAY, FRIDAY])
  defaultDeliveryTimeMinutes Int                         @default(750)
  deliveryMinutesBefore      Int                         @default(60)
  defaultPackaging           String                      @db.VarChar(40)
  driverInstructions         String?                     @db.VarChar(1000)
  pricingTierId              String?                     @db.Uuid
  defaultDriverId            String?                     @db.Uuid
  ownerEmployeeId            String?                     @unique @db.Uuid
  isActive                   Boolean                     @default(true)
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  pricingTier                PricingTier?                @relation("CompanyPricingTier", fields: [pricingTierId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  defaultDriver              StaffUser?                  @relation("CompanyDefaultDriver", fields: [defaultDriverId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  ownerEmployee              Employee?                   @relation("CompanyOwner", fields: [ownerEmployeeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  employees                  Employee[]                  @relation("CompanyEmployees")
  emailDomains               CompanyEmailDomain[]
  addresses                  CompanyAddress[]
  holidays                   CompanyHoliday[]
  hiddenMenuCategories       CompanyHiddenMenuCategory[]
  hiddenMenuItems            CompanyHiddenMenuItem[]
  orders                     Order[]                     @relation("CompanyOrders")
  dispatchDrops              DispatchDrop[]
  invoices                   Invoice[]
}

model CompanyEmailDomain {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @db.Uuid
  domain    String   @unique @db.VarChar(253)
  createdAt DateTime @default(now())
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

model CompanyAddress {
  id           String   @id @default(uuid()) @db.Uuid
  companyId    String   @db.Uuid
  label        String   @db.VarChar(80)
  addressLine1 String   @db.VarChar(160)
  addressLine2 String?  @db.VarChar(160)
  city         String   @db.VarChar(80)
  stateRegion  String   @db.VarChar(80)
  postalCode   String   @db.VarChar(32)
  country      String   @db.VarChar(80)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  orders       Order[]  @relation("CompanyAddressOrders")
}

model CompanyHoliday {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @db.Uuid
  date      DateTime @db.Date
  name      String?  @db.VarChar(120)
  createdAt DateTime @default(now())
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([companyId, date])
}

model Employee {
  id                       String               @id @default(uuid()) @db.Uuid
  companyId                String               @db.Uuid
  name                     String               @db.VarChar(160)
  email                    String               @db.VarChar(320)
  phone                    String?              @db.VarChar(32)
  canChooseDeliveryAddress Boolean              @default(false)
  canChangeDeliveryTime    Boolean              @default(false)
  canChangePackaging       Boolean              @default(false)
  isActive                 Boolean              @default(true)
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt
  company                  Company              @relation("CompanyEmployees", fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  allergens                EmployeeAllergen[]
  dietaryTags              EmployeeDietaryTag[]
  ownedCompany             Company?             @relation("CompanyOwner")
  orders                   Order[]              @relation("EmployeeOrders")

  @@unique([companyId, email])
}

model EmployeeAllergen {
  employeeId String   @db.Uuid
  allergenId String   @db.Uuid
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  allergen   Allergen @relation(fields: [allergenId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([employeeId, allergenId])
}

model EmployeeDietaryTag {
  employeeId   String     @db.Uuid
  dietaryTagId String     @db.Uuid
  employee     Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  dietaryTag   DietaryTag @relation(fields: [dietaryTagId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([employeeId, dietaryTagId])
}

model MenuCategory {
  id                 String                      @id @default(uuid()) @db.Uuid
  name               String                      @db.VarChar(80)
  normalizedName     String                      @unique @db.VarChar(80)
  sortOrder          Int
  isSecret           Boolean                     @default(false)
  isActive           Boolean                     @default(true)
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt
  items              MenuCategoryItem[]
  hiddenForCompanies CompanyHiddenMenuCategory[]
}

model MenuCategoryItem {
  id                 String                  @id @default(uuid()) @db.Uuid
  categoryId         String                  @db.Uuid
  dishId             String                  @db.Uuid
  sortOrder          Int
  isActive           Boolean                 @default(true)
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  category           MenuCategory            @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  dish               Dish                    @relation(fields: [dishId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  hiddenForCompanies CompanyHiddenMenuItem[]

  @@unique([categoryId, dishId])
}

model CompanyHiddenMenuCategory {
  companyId  String       @db.Uuid
  categoryId String       @db.Uuid
  company    Company      @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  category   MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([companyId, categoryId])
}

model CompanyHiddenMenuItem {
  companyId          String           @db.Uuid
  menuCategoryItemId String           @db.Uuid
  company            Company          @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  menuCategoryItem   MenuCategoryItem @relation(fields: [menuCategoryItemId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([companyId, menuCategoryItemId])
}

enum OrderStatus {
  DRAFT
  PLACED
  CONFIRMED
  DELIVERED
  CANCELLED
  REJECTED
}

enum InvoiceStatus {
  OPEN
  PAID
}

model Invoice {
  id              String        @id @default(uuid()) @db.Uuid
  companyId       String        @db.Uuid
  status          InvoiceStatus @default(OPEN)
  totalMinorUnits Int
  createdAt       DateTime      @default(now())
  paidAt          DateTime?     @db.Timestamptz(3)
  company         Company       @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  orders          Order[]

  @@index([companyId, status, createdAt])
}

model Order {
  id                            String             @id @default(uuid()) @db.Uuid
  employeeId                    String             @db.Uuid
  companyId                     String             @db.Uuid
  effectivePricingTierId        String             @db.Uuid
  pricingTierNameSnapshot       String             @db.VarChar(80)
  status                        OrderStatus        @default(DRAFT)
  deliveryDate                  DateTime           @db.Date
  cutoffAt                      DateTime           @db.Timestamptz(3)
  sourceCompanyAddressId        String             @db.Uuid
  deliveryAddressLabel          String             @db.VarChar(80)
  deliveryAddressLine1          String             @db.VarChar(160)
  deliveryAddressLine2          String?            @db.VarChar(160)
  deliveryCity                  String             @db.VarChar(80)
  deliveryStateRegion           String             @db.VarChar(80)
  deliveryPostalCode            String             @db.VarChar(32)
  deliveryCountry               String             @db.VarChar(80)
  deliveryTimeMinutes           Int
  deliveryMinutesBeforeSnapshot Int
  packaging                     String             @db.VarChar(40)
  driverInstructionsSnapshot    String?            @db.VarChar(1000)
  dispatchDropId                String?            @db.Uuid
  invoiceId                     String?            @db.Uuid
  totalMinorUnits               Int
  createdAt                     DateTime           @default(now())
  updatedAt                     DateTime           @updatedAt
  employee                      Employee           @relation("EmployeeOrders", fields: [employeeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  company                       Company            @relation("CompanyOrders", fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  effectivePricingTier          PricingTier        @relation("OrderEffectivePricingTier", fields: [effectivePricingTierId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  sourceCompanyAddress          CompanyAddress     @relation("CompanyAddressOrders", fields: [sourceCompanyAddressId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  dispatchDrop                  DispatchDrop?      @relation(fields: [dispatchDropId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  invoice                       Invoice?           @relation(fields: [invoiceId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  lines                         OrderLine[]
  statusEvents                  OrderStatusEvent[]

  @@index([deliveryDate, status])
  @@index([companyId, deliveryDate])
  @@index([employeeId, deliveryDate])
  @@index([effectivePricingTierId])
  @@index([dispatchDropId])
  @@index([invoiceId])
}

model OrderLine {
  id                         String             @id @default(uuid()) @db.Uuid
  orderId                    String             @db.Uuid
  dishId                     String             @db.Uuid
  dishNameSnapshot           String             @db.VarChar(120)
  dishSkuSnapshot            String             @db.VarChar(64)
  kitchenStationId           String?            @db.Uuid
  kitchenStationNameSnapshot String?            @db.VarChar(80)
  quantity                   Int
  dishUnitPriceMinorUnits    Int
  lineTotalMinorUnits        Int
  createdAt                  DateTime           @default(now())
  order                      Order              @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  dish                       Dish               @relation("DishOrderLines", fields: [dishId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  kitchenStation             KitchenStation?    @relation("KitchenStationOrderLines", fields: [kitchenStationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  combinations               OrderCombination[]

  @@unique([orderId, dishId])
  @@index([kitchenStationId])
}

model OrderCombination {
  id                  String                   @id @default(uuid()) @db.Uuid
  orderLineId         String                   @db.Uuid
  selectionKey        String
  quantity            Int
  unitPriceMinorUnits Int
  totalMinorUnits     Int
  kitchenStartedAt    DateTime?                @db.Timestamptz(3)
  kitchenCompletedAt  DateTime?                @db.Timestamptz(3)
  createdAt           DateTime                 @default(now())
  orderLine           OrderLine                @relation(fields: [orderLineId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  selectedOptions     OrderCombinationOption[]

  @@unique([orderLineId, selectionKey])
}

enum DispatchDropStatus {
  WAITING_KITCHEN
  DISPATCH_READY
  OUT_FOR_DELIVERY
  DELIVERED
}

model DispatchDrop {
  id                  String             @id @default(uuid()) @db.Uuid
  groupingKey         String             @unique @db.VarChar(64)
  companyId           String             @db.Uuid
  deliveryDate        DateTime           @db.Date
  deliveryTimeMinutes Int
  assignedDriverId    String?            @db.Uuid
  status              DispatchDropStatus @default(WAITING_KITCHEN)
  dispatchReadyAt     DateTime?          @db.Timestamptz(3)
  outForDeliveryAt    DateTime?          @db.Timestamptz(3)
  deliveredAt         DateTime?          @db.Timestamptz(3)
  deliveryNote        String?            @db.VarChar(1000)
  deliveryPhotoUrl    String?            @db.VarChar(2048)
  wasOnTime           Boolean?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  company             Company            @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  assignedDriver      StaffUser?         @relation("DispatchDropDriver", fields: [assignedDriverId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  orders              Order[]

  @@index([deliveryDate, status])
  @@index([companyId, deliveryDate])
  @@index([assignedDriverId, deliveryDate])
}

model OrderCombinationOption {
  orderCombinationId        String           @db.Uuid
  optionGroupId             String           @db.Uuid
  optionId                  String           @db.Uuid
  optionGroupNameSnapshot   String           @db.VarChar(80)
  optionNameSnapshot        String           @db.VarChar(80)
  optionUnitPriceMinorUnits Int
  orderCombination          OrderCombination @relation(fields: [orderCombinationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  optionGroup               OptionGroup      @relation("OrderCombinationOptionGroups", fields: [optionGroupId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  option                    Option           @relation("OrderCombinationOptions", fields: [optionId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([orderCombinationId, optionGroupId])
  @@index([optionId])
}

model OrderStatusEvent {
  id               String       @id @default(uuid()) @db.Uuid
  orderId          String       @db.Uuid
  fromStatus       OrderStatus?
  toStatus         OrderStatus
  occurredAt       DateTime     @default(now()) @db.Timestamptz(3)
  actorStaffUserId String?      @db.Uuid
  note             String?      @db.VarChar(500)
  order            Order        @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  actorStaffUser   StaffUser?   @relation("OrderStatusEventActor", fields: [actorStaffUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([orderId, occurredAt])
}
